# Included by every public location in nginx.conf.template.
proxy_pass http://ecocommit_wsgi;
proxy_http_version 1.1;
proxy_request_buffering on;
proxy_buffering on;
proxy_connect_timeout 5s;
proxy_read_timeout 90s;
proxy_send_timeout 90s;

# Replace all client-supplied forwarding metadata at the sole trusted proxy.
proxy_set_header Host @@PUBLIC_HOST@@;
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Host @@PUBLIC_HOST@@;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port 443;
proxy_set_header X-Real-IP "";
proxy_set_header Transfer-Encoding "";
proxy_set_header Connection "";
