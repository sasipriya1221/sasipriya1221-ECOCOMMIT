# Reviewed single-host baseline. Replace @@...@@ tokens without changing the
# forwarded-header, body-size, or upstream-binding policies.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    log_format ecocommit_edge escape=json
        '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
        '"request_id":"$request_id","host":"$host","method":"$request_method",'
        '"uri":"$uri","status":$status,"bytes":$body_bytes_sent,'
        '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';
    access_log @@ACCESS_LOG_PATH@@ ecocommit_edge;
    error_log  @@ERROR_LOG_PATH@@ warn;

    # Shared across nginx workers on this host. A multi-host deployment still
    # requires an external distributed limiter and is outside the current claim.
    limit_req_zone $binary_remote_addr zone=ecocommit_general:10m rate=60r/m;
    limit_req_zone $binary_remote_addr zone=ecocommit_commit:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=ecocommit_webhook:10m rate=120r/m;
    limit_conn_zone $binary_remote_addr zone=ecocommit_connections:10m;
    limit_req_status 429;
    limit_conn_status 429;

    upstream ecocommit_wsgi {
        # The WSGI listener must bind only to this loopback address and run one
        # worker. Never expose it directly or put a public load balancer here.
        server 127.0.0.1:@@WSGI_PORT@@;
        keepalive 16;
    }

    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 80;
        server_name @@PUBLIC_HOST@@;
        return 308 https://@@PUBLIC_HOST@@$request_uri;
    }

    # A default TLS vhost rejects valid handshakes carrying an unknown Host/SNI.
    server {
        listen 443 ssl default_server;
        server_name _;
        ssl_certificate     @@TLS_CERTIFICATE_PATH@@;
        ssl_certificate_key @@TLS_PRIVATE_KEY_PATH@@;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 421;
    }

    server {
        listen 443 ssl;
        server_name @@PUBLIC_HOST@@;

        # A request cannot use an unrelated/absent SNI value and then switch to
        # the accepted virtual host through its HTTP Host header.
        if ($ssl_server_name != "@@PUBLIC_HOST@@") { return 421; }

        ssl_certificate     @@TLS_CERTIFICATE_PATH@@;
        ssl_certificate_key @@TLS_PRIVATE_KEY_PATH@@;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:ECOCOMMIT_TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        client_max_body_size 64k;
        client_body_buffer_size 64k;
        client_body_timeout 15s;
        client_header_timeout 15s;
        keepalive_timeout 30s;
        send_timeout 90s;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()" always;

        limit_conn ecocommit_connections 20;

        location = /v1/commit {
            limit_req zone=ecocommit_commit burst=2 nodelay;
            include @@PROXY_POLICY_INCLUDE@@;
        }

        location = /v1/razorpay/webhook {
            limit_req zone=ecocommit_webhook burst=20 nodelay;
            include @@PROXY_POLICY_INCLUDE@@;
        }

        location / {
            limit_req zone=ecocommit_general burst=20 nodelay;
            include @@PROXY_POLICY_INCLUDE@@;
        }
    }
}
