# Non-secret deployment contract. Replace every example path and hostname.
ECOCOMMIT_D_PUBLIC_HOST=ecocommit.example.test
ECOCOMMIT_D_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ECOCOMMIT_D_TLS_TERMINATION=TRUSTED_REVERSE_PROXY
ECOCOMMIT_D_EDGE_RATE_LIMITING=EXTERNAL_SHARED_LIMITER_REQUIRED
ECOCOMMIT_D_MAX_REQUEST_BODY_BYTES=65536
ECOCOMMIT_D_INSTANCE_COUNT=1
ECOCOMMIT_D_WORKER_COUNT=1
ECOCOMMIT_D_PROVIDER_MODE=DISABLED
ECOCOMMIT_D_PERSISTENT_ROOT=/var/lib/ecocommit
ECOCOMMIT_D_AUDIT_PATH=/var/lib/ecocommit/audit/events.ndjson

# Optional read-only authoritative evidence mount; all three are inseparable.
# ECOCOMMIT_D_EVIDENCE_ROOT=/run/ecocommit/evidence
# ECOCOMMIT_D_PINS_PATH=/run/ecocommit/evidence/pins.json
# ECOCOMMIT_D_PINS_SHA256=<lowercase-64-character-sha256>

# RAZORPAY_TEST_MODE only; all three are inseparable and pinned evidence is required.
# ECOCOMMIT_D_PREPARED_OPERATION_PATH=/run/ecocommit/operation/prepared.json
# ECOCOMMIT_D_PREPARED_OPERATION_SHA256=<lowercase-64-character-sha256>
# ECOCOMMIT_D_STATE_DB_PATH=/var/lib/ecocommit/state/ecocommit.sqlite3

# Secrets must be injected by the runtime secret store, never this file.
# ECOCOMMIT_D_API_TOKEN=
# ECOCOMMIT_D_SIGNING_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
